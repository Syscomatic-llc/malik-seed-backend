# Docker PostgreSQL
# The backend container connects to the postgres service internally.
# Do not set DATABASE_URL to localhost for Docker deployment.
POSTGRES_DB=malikseed
POSTGRES_USER=malikseed
POSTGRES_PASSWORD=change-this-postgres-password

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# SMTP (optional - defaults to console mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@malikseed.com
ADMIN_EMAIL=admin@malikseed.com

# First admin user
FIRST_ADMIN_EMAIL=admin@malikseed.com
FIRST_ADMIN_PASSWORD=admin123
