# Database
DATABASE_URL=sqlite:///./malikseed_cms.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/malikseed_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# SMTP (optional - defaults to console mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@malikseed.com
ADMIN_EMAIL=admin@malikseed.com

# First admin user
FIRST_ADMIN_EMAIL=admin@malikseed.com
FIRST_ADMIN_PASSWORD=admin123
